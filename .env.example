# Copia este archivo a .env y completa los valores. NO subas .env al repositorio.

# --- Django ---
# En desarrollo local pon true. En produccion DEJALO en false (o no lo definas).
DJANGO_DEBUG=true
# Obligatoria cuando DJANGO_DEBUG=false. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo produccion, con https:// (ej: https://pedidocentral.onrender.com)
CSRF_TRUSTED_ORIGINS=

# --- Base de datos MySQL 8 ---
DB_NAME=pedidocentral
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Zona horaria de la sesion MySQL (Colombia = -05:00). Evita reportes corridos si el servidor esta en UTC.
DB_TIME_ZONE=-05:00
# Ruta al certificado CA si tu MySQL en la nube exige SSL (opcional)
DB_SSL_CA=

# --- Seguridad en produccion (opcionales) ---
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600
# CACHE_DIR=/tmp/pedidocentral_cache
